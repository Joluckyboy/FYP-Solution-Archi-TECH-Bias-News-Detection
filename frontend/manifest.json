{
  "name": "Checkmate",
  "description": "News Bias Detector - Analyze articles for propaganda and sentiment",
  "version": "0.4",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "downloads",
    "tabCapture",
    "offscreen",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Checkmate - News Bias Detector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "checkmate.png",
      "32": "checkmate.png",
      "48": "checkmate.png",
      "128": "checkmate.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
