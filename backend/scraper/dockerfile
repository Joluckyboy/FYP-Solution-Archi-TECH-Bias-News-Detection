# Stage 1: Build stage
FROM python:3.11-slim AS build

WORKDIR /app

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

# Stage 2: Production stage
FROM python:3.11-slim

# Install runtime system dependencies (tesseract, poppler needed at runtime)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    libtesseract-dev \
    poppler-utils \
    libglib2.0-0 \
    libnss3 \
    libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=build /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=build /usr/local/bin /usr/local/bin

COPY . .

RUN mkdir -p /app/datasets && \
    chmod -R 777 /app/datasets

EXPOSE 8015

CMD ["gunicorn", "--timeout", "1800", "--workers", "2", "--worker-class", "sync", "--max-requests", "50", "--max-requests-jitter", "10", "-b", "0.0.0.0:8015", "app:app"]
